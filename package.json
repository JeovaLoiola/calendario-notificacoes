{
  "name": "calendario-notificacoes",
  "version": "1.0.0",
  "description": "Sistema de Calendário, Gerenciamento de Tarefas e Envio de Notificações por E-mail",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "serverless-http": "^4.0.0"
  }
}
